INTEGRATED_RELEASE=replace-with-content-revision
SECRET_KEY=replace-with-independent-random-48-byte-value
AES_SECRET_KEY=replace-with-another-independent-random-48-byte-value
DEBUG=False
ALLOWED_HOSTS=47.80.22.243,127.0.0.1,localhost
DB_ENGINE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tradetools_integrated
DB_USER=tt_integrated
DB_PASSWORD=replace-with-a-new-database-password
MYSQL_ROOT_PASSWORD=replace-with-an-independent-mysql-root-password
USE_REDIS_CACHE=True
REDIS_URL=redis://redis:6379/0
MARKET_REDIS_URL=redis://redis:6379/0
CACHE_KEY_PREFIX=tradetools-integrated
BINANCE_QUOTE_ASSET=USDT
MARKET_WS_URL=wss://fstream.binance.com/market
# Project policy, not an exchange quota. Shared by market and account streams.
MARKET_WS_ATTEMPTS_PER_MINUTE=30
MARKET_WS_CONNECT_SPACING_SECONDS=1
ACCOUNT_WS_URL=wss://fstream.binance.com/private
MARKET_STREAM_ENABLED=true
ACCOUNT_STREAM_ENABLED=true
RUN_SCHEDULER_IN_WEB=false
MARKET_SNAPSHOT_PREWARM_ENABLED=False
PUBLIC_APP_URL=https://47.80.22.243/integrated
CORS_ALLOWED_ORIGINS=https://47.80.22.243
AUTH_REFRESH_COOKIE_NAME=integrated_refresh
AUTH_REFRESH_COOKIE_PATH=/integrated/
AUTH_REFRESH_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
LEAD_TRADING_ENABLED=false
INTEGRATED_BOOTSTRAP_EMAIL=replace-with-initial-admin-email
INTEGRATED_BOOTSTRAP_PASSWORD=replace-with-random-password-at-least-16-characters

# APNs key directory is mounted read-only into the notification scheduler.
APNS_ENABLED=false
APNS_TEAM_ID=replace-with-apple-team-id
APNS_KEY_ID=replace-with-apns-key-id
APNS_SECRET_DIRECTORY=/opt/trade-tools-integrated/secrets
APNS_KEY_PATH=/run/tradetools-secrets/AuthKey.p8
APNS_BUNDLE_ID=com.waibao2025.trade.integrated
# Reuse the original Echobell channel, never place a real hook URL in source.
POSITION_PROFIT_CALL_ENABLED=false
POSITION_PROFIT_CALL_USER_ID=0
POSITION_PROFIT_CALL_URL=
SIGNAL_ECHOBELL_ENABLED=false
