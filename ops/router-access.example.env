# 软路由备注名称，仅用于区分设备
ROUTER_NAME='openclash-router'

# 软路由 LAN 地址，可以填写 IP 或本地域名
ROUTER_HOST='192.168.1.1'

# OpenWrt/LuCI 管理页面
ROUTER_WEB_SCHEME='http'
ROUTER_WEB_PORT='80'
ROUTER_WEB_USER='root'

# LuCI 登录密码；请只填写在 router-access.env 中，不要提交到 Git
ROUTER_WEB_PASSWORD=''

# SSH 诊断信息；没有开启 SSH 时将 ROUTER_SSH_ENABLED 改为 false
ROUTER_SSH_ENABLED='true'
ROUTER_SSH_PORT='22'
ROUTER_SSH_USER='root'
ROUTER_SSH_PASSWORD=''

# 可选：OpenClash Dashboard/API 信息；未单独配置可保持为空
OPENCLASH_DASHBOARD_URL=''
OPENCLASH_CONTROLLER_SECRET=''

# 可选备注，例如当前使用的配置文件名、代理模式或旁路由拓扑
ROUTER_NOTES=''
