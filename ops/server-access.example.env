# 服务器备注名称，仅用于区分环境
SERVER_NAME='trade-tool-prod'

# SSH 地址，可以填写 IP 或域名
SERVER_HOST='192.168.100.100'

# SSH 端口
SERVER_PORT='22'

# SSH 登录用户名
SERVER_USER=''

# SSH 登录密码；请只填写在 server-access.env 中，不要提交到 Git
SERVER_PASSWORD=''

# 如果 SSH 使用私钥，填写本机私钥绝对路径；使用密码登录时保持为空
SERVER_IDENTITY_FILE=''

# 仅在检查命令确实需要 sudo 且 sudo 密码与登录密码不同时填写
SERVER_SUDO_PASSWORD=''

# Trade Tool 在服务器上的部署目录
SERVER_APP_DIR='/opt/trade-tool'

# 服务器上的 Docker 命令；普通用户需要 sudo 时填写 sudo docker
SERVER_DOCKER_COMMAND='docker'

# 服务器上的 Docker Compose 命令；普通用户需要 sudo 时填写 sudo docker compose
SERVER_COMPOSE_COMMAND='docker compose'
