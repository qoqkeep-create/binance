# Docker Compose 项目标识
COMPOSE_PROJECT_NAME=trade-tool

# 应用镜像名称和标签；Jenkins 部署时会在服务器 .deploy.env 中覆盖这两个值
APP_IMAGE=trade-tool-app
APP_TAG=latest

# Binance USD-M 报价资产；支持切换 USDC、USDT 等实际存在的 USD-M 报价资产
BINANCE_QUOTE_ASSET=USDC
# 币安全市场 ticker 数组单条消息上限；默认 1MB，不能低于 Jetty 的 64KB
BINANCE_MARKET_TICKER_MESSAGE_MAX_BYTES=1048576

# Java服务器端Binance凭证加密。首次部署使用 `openssl rand -base64 32` 生成，
# 真实值只能放在部署服务器.env/Jenkins密钥中；丢失后已保存的Binance凭证无法解密。
TRADING_CREDENTIAL_MASTER_KEY=
TRADING_CREDENTIAL_KEY_VERSION=v1
BINANCE_TRADING_REST_BASE_URL=https://fapi.binance.com
# 账户监听默认关闭；完成 Futures Testnet 验收后再启用。账户必须同步完成才可下单。
TRADING_ACCOUNT_SYNC_ENABLED=false
BINANCE_TRADING_USER_STREAM_BASE_URL=wss://fstream.binance.com/private

# 生产容器资源上限；当前服务器还运行其他 Compose 项目，不能让新服务无上限争抢内存
APP_MEMORY_LIMIT=1g
MYSQL_MEMORY_LIMIT=768m
REDIS_MEMORY_LIMIT=256m
# JVM 参数；堆上限必须显著低于 APP_MEMORY_LIMIT，为线程、Netty 和元空间保留余量
JAVA_TOOL_OPTIONS=-Xms256m -Xmx640m -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai -Dio.netty.noUnsafe=true

# 日志文件；Jenkins 远程部署会在 .deploy.env 中把 LOG_DIR 覆盖为 /opt/trade-tool/logs
LOG_DIR=./logs
LOG_FILE=/app/logs/trade-tool.log
LOG_MAX_FILE_SIZE=50MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=2GB

# MySQL
MYSQL_DATABASE=trade-tool
MYSQL_USER=trade_app
MYSQL_PASSWORD=change_me_app_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PORT=3306
MYSQL_DATA_DIR=/opt/trade-tool/mysql/data

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379
REDIS_DATA_DIR=/opt/trade-tool/redis/data

# 生产基础服务仅监听宿主机回环地址；远程排障请使用 SSH 隧道，禁止直接暴露公网
INFRA_BIND_HOST=127.0.0.1

# 本地 iOS 真机调试需要暴露到局域网；生产 compose.remote 仍只绑定宿主机回环地址
APP_BIND_HOST=0.0.0.0
APP_PORT=8686

# iOS/API 初始管理员；仅在数据库中不存在该账号时创建
# 密码至少 12 位，首次部署完成后建议从部署环境中移除 APP_ADMIN_PASSWORD
APP_ADMIN_ACCOUNT=admin
APP_ADMIN_PASSWORD=change_me_admin_password
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_DISPLAY_NAME=Administrator
APP_REGISTRATION_ENABLED=true

# APNs 远程策略通知；私钥为 AuthKey_*.p8 文件整体的 Base64 单行内容，禁止提交真实值
APNS_NOTIFICATION_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_BASE64=
APNS_TOPIC=com.oovso.trade
APNS_REQUEST_TIMEOUT_MILLIS=10000
APNS_EXPIRATION_SECONDS=21600
APNS_MAX_ATTEMPTS=3
APNS_RETRY_DELAY_MILLIS=1000
# 纯文本策略信号 Webhook；访问 key 只能保存在实际 .env/Jenkins Secret file
WEBHOOK_NOTIFICATION_ENABLED=false
STRATEGY_SIGNAL_WEBHOOK_URL=
STRATEGY_SIGNAL_WEBHOOK_KEY=
WEBHOOK_NOTIFICATION_ZONE_ID=Asia/Shanghai
WEBHOOK_CONNECT_TIMEOUT_MILLIS=5000
WEBHOOK_REQUEST_TIMEOUT_MILLIS=10000
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MILLIS=1000
# 通用外部 JSON 消息接收接口；使用 `openssl rand -hex 32` 生成独立密钥
EXTERNAL_MESSAGE_ENABLED=false
EXTERNAL_MESSAGE_API_KEY=
# 参考通知列表与 APNs 的目标 App 账号
REFERENCE_TRADE_NOTIFICATION_TARGET_EMAIL=475842526@qq.com
