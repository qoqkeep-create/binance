SECRET_KEY=replace-with-a-long-random-string
AES_SECRET_KEY=replace-with-a-dedicated-random-string
# Temporary key-ring entry used only while rotating encrypted database values.
AES_PREVIOUS_SECRET_KEY=
DEBUG=True
DATA_UPLOAD_MAX_MEMORY_SIZE=262144
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
AUTH_REFRESH_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
PASSWORD_RESET_TIMEOUT=1800
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=3600
AUTH_LOGIN_LOCK_SECONDS=180
AUTH_LOGIN_ACCOUNT_MAX_FAILURES=10
AUTH_LOGIN_IP_MAX_FAILURES=50
AUTH_REGISTER_IP_MAX_ATTEMPTS=10
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600

# mysql or sqlite
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=riskon
DB_USER=riskon
DB_PASSWORD=replace-with-db-password

# Enable Redis cache for login fail counter in production-like setup
USE_REDIS_CACHE=False
REDIS_URL=redis://127.0.0.1:6379/0

LOG_LEVEL=INFO

# Binance Futures
# prod => https://fapi.binance.com
# testnet => https://demo-fapi.binance.com
BINANCE_ENV=prod
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# 现货域名（可选）：留空时自动跟随合约环境（生产 api.binance.com / 测试网 testnet.binance.vision）
BINANCE_SPOT_BASE_URL=
BINANCE_TIMEOUT_SECONDS=10
BINANCE_RECV_WINDOW=5000
BINANCE_DEFAULT_MAX_LEVERAGE=125
# Shared Redis request-budget guard. Ratios reserve capacity for trading and protection calls.
BINANCE_FUTURES_WEIGHT_LIMIT_PER_MINUTE=2400
BINANCE_SPOT_WEIGHT_LIMIT_PER_MINUTE=6000
BINANCE_SAPI_WEIGHT_LIMIT_PER_MINUTE=12000
BINANCE_BACKGROUND_WEIGHT_RATIO=0.65
BINANCE_NORMAL_WEIGHT_RATIO=0.85
BINANCE_CRITICAL_WEIGHT_RATIO=0.96
BINANCE_ORDER_LIMIT_PER_MINUTE=1200
BINANCE_ORDER_LIMIT_RATIO=0.95
# Open only after mode isolation and MySQL / Redis acceptance.
LEAD_TRADING_ENABLED=false
# Disable scheduler use only after repeated deterministic authentication failures.
BINANCE_AUTH_FAILURE_THRESHOLD=3
BINANCE_AUTH_FAILURE_WINDOW_SECONDS=21600
# Optional: set your production server public IPv4 for API whitelist strict check
SERVER_PUBLIC_IP=

# Market analysis scheduler (uses the existing TradingView webhook container for WeCom delivery)
MARKET_ANALYSIS_SIGNAL_RETENTION_DAYS=90
MARKET_ANALYSIS_ALERT_URL=http://tradingview-webhook:3000/internal/market-scan
MARKET_ANALYSIS_ALERT_TOKEN=replace-with-a-random-internal-alert-token
# Public K-line snapshot CDN prewarm: request the public snapshot URL on each
# candle interval's cache cadence so the Alibaba Cloud CDN copy stays warm and
# mainland first paint never falls back to a cross-border origin fetch.
MARKET_SNAPSHOT_PREWARM_ENABLED=true
MARKET_SNAPSHOT_PREWARM_URL=https://ba.wow211.com
OPS_ALERT_URL=http://tradingview-webhook:3000/internal/ops-alert
OPS_ALERT_TOKEN=
OPS_ALERT_TIMEOUT_SECONDS=5
