# Local integrated development only. Use deploy/integrated/server.env.example on the server.
SECRET_KEY=replace-with-a-long-random-string
AES_SECRET_KEY=replace-with-an-independent-long-random-string
AES_PREVIOUS_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite
USE_REDIS_CACHE=True
REDIS_URL=redis://127.0.0.1:6379/0
MARKET_REDIS_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=tradetools-integrated-local
RUN_SCHEDULER_IN_WEB=false
BINANCE_QUOTE_ASSET=USDT
MARKET_WS_URL=wss://fstream.binance.com/market
# Shared market/account reconnect limits; reduce attempts for a shared NAT/proxy.
MARKET_WS_ATTEMPTS_PER_MINUTE=30
MARKET_WS_CONNECT_SPACING_SECONDS=1
ACCOUNT_WS_URL=wss://fstream.binance.com/private
MARKET_STREAM_ENABLED=true
ACCOUNT_STREAM_ENABLED=true
MARKET_SNAPSHOT_PREWARM_ENABLED=False
LEAD_TRADING_ENABLED=false
PUBLIC_APP_URL=http://127.0.0.1:8787
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8787
AUTH_REFRESH_COOKIE_NAME=integrated_local_refresh
AUTH_REFRESH_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
MARKET_ANALYSIS_ALERT_URL=
OPS_ALERT_URL=
TRADE_NOTIFICATION_URL=
EXTERNAL_TRADE_SIGNAL_ENABLED=false
